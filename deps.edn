{:paths ["src" "resources"]
 ;; Pinned as git deps (not :local/root) so this actor resolves standalone
 ;; from a clean clone with no monorepo siblings present — same convention
 ;; org-chainagnostic-cacao's deps.edn documents (ADR-2607022400). SHAs are
 ;; each sibling repo's origin/main HEAD as of 2026-07-19.
 :deps {io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "6daa48e7bf86acc13d44804104fced4938530fd2"}
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/langchain-store.git"
         :git/sha "2615e5213711945491a1b1c953625943c4ea83e1"}
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "7c880cbe8757fbde3bc5b4c5d6943f15378b1305"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}}
 :aliases
 {;; Monorepo-local dev/test — resolve every sibling from the west-managed
  ;; sibling checkouts. This repo lives at orgs/net-kotobase/commoncrawl-actor
  ;; since the 2026-08 transfer, while every sibling below is still a
  ;; kotoba-lang project — so these are ../../kotoba-lang/<name>, not ../<name>
  ;; (the same layout gftd-talent-actor's :dev alias and
  ;; org-chainagnostic-cacao's :local alias both use).
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph              {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain-store         {:local/root "../../kotoba-lang/langchain-store"}
         io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../../kotoba-lang/org-chainagnostic-cacao"}
         io.github.kotoba-lang/org-ietf-ed25519        {:local/root "../../kotoba-lang/org-ietf-ed25519"}
         io.github.kotoba-lang/org-ietf-cbor           {:local/root "../../kotoba-lang/org-ietf-cbor"}
         ;; langchain is langgraph's own transitive dep; pin the same local
         ;; checkout so the whole graph resolves from one workspace.
         io.github.kotoba-lang/langchain                {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  → drive one offline dry-run tick through the actor
  :run {:main-opts ["-m" "commoncrawl.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
